# Copy to .env (git-ignored). Without .env the desk runs on data/deals.csv.
# DESK_BACKEND=hubspot makes every agent read and write deals in HubSpot.
DESK_BACKEND=hubspot
# HubSpot service key: Development > Keys > Service keys, with scopes
# crm.objects.deals.read, crm.objects.deals.write,
# crm.schemas.deals.read, crm.schemas.deals.write
HUBSPOT_TOKEN=
